# ================================================================
# GAZUA — Environment Variables
# Copy this file to .env and fill in your values.
# Variables prefixed with VITE_ are bundled into the frontend.
# All others are server-side only (webhook handlers, Edge Functions).
# ================================================================

# --- Supabase (safe to expose in frontend) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Supabase (server-side only — never in VITE_ prefix) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (safe to expose in frontend) ---
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# --- Stripe (server-side only) ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Stripe Price IDs (maps price → subscription tier in webhook handler) ---
STRIPE_PRICE_ID_ANALYST=price_...
STRIPE_PRICE_ID_EDUCATOR=price_...

# --- Polygon.io market data (safe to expose — rate-limited per key) ---
VITE_POLYGON_API_KEY=

# --- Anthropic (server-side only — stored as a Supabase Edge Function secret) ---
# DO NOT add VITE_ANTHROPIC_API_KEY here. The key lives exclusively in Supabase secrets.
# To set it:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set ALLOWED_ORIGIN=https://yourdomain.com
# The Edge Function is at supabase/functions/claude-insights/index.ts
# Deploy it with: supabase functions deploy claude-insights --project-ref <ref>

# --- Supabase Storage bucket names ---
VITE_STORAGE_BUCKET_AVATARS=avatars
VITE_STORAGE_BUCKET_VIDEOS=videos
VITE_STORAGE_BUCKET_REELS=reels
VITE_STORAGE_BUCKET_MODELS=models
VITE_STORAGE_BUCKET_THUMBNAILS=thumbnails
